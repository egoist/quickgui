{
  "name": "quickgui-workspace",
  "version": "0.1.4-next.3",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "benchmarks/desktop/quickgui-typescript",
    "website"
  ],
  "scripts": {
    "build": "bun run --cwd website build",
    "deploy": "bun run --cwd website deploy",
    "build:native": "bun run --filter @quickgui/native build",
    "test:js": "bun test ./packages/cli ./scripts/benchmark-memory.test.ts",
    "test:typescript": "bun scripts/check-typescript-coverage.ts && bun test --preload ./packages/solid/test/preload.ts ./packages/solid/test ./packages/native/test ./packages/extension-updater/test && bun run --cwd examples/quick-git-typescript test",
    "typecheck:js": "bun benchmarks/desktop/quickgui-typescript/generate.ts && bunx tsc -p tsconfig.json --noEmit",
    "version:sync": "bun scripts/sync-release-version.ts",
    "version:check": "bun scripts/sync-release-version.ts --check",
    "test:go": "bash scripts/check-go.sh",
    "fmt:go": "go -C go run ./cmd/quickguifmt -w ../go ../examples",
    "fmt:go:check": "go -C go run ./cmd/quickguifmt -check ../go ../examples"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.67.0",
    "typescript": "7.0.2"
  }
}
