{
  "name": "quickgui-workspace",
  "version": "0.1.3",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "scripts": {
    "build:native": "bun run --filter @quickgui/native build",
    "test:js": "bun test ./packages/native ./packages/ui ./packages/cli",
    "test:go": "CGO_ENABLED=0 go test ./packages/go/...",
    "typecheck:js": "bunx tsc -p tsconfig.json --noEmit",
    "version:sync": "node scripts/sync-release-version.mjs",
    "version:check": "node scripts/sync-release-version.mjs --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "@types/node": "^24.0.0"
  }
}
