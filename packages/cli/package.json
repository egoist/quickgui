{
  "name": "@quickgui/cli",
  "version": "0.1.3",
  "description": "Project, development, and packaging CLI for natively compiled QuickGUI applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist/quickgui.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/egoist/quickgui/issues",
  "homepage": "https://github.com/egoist/quickgui#readme",
  "type": "module",
  "bin": {
    "quickgui": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "README.md",
    "src/args.ts",
    "src/build.ts",
    "src/cli.ts",
    "src/config.ts",
    "src/dev.ts",
    "src/error.ts",
    "src/go-build.ts",
    "src/index.ts",
    "src/init.ts",
    "src/jsx-lowering.ts",
    "src/modules.ts",
    "src/native-build.ts",
    "src/native-compiler.ts",
    "src/targets.ts",
    "templates",
    "src/packaging",
    "!**/*.test.ts"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@quickgui/native": "workspace:*",
    "@quickgui/ui": "workspace:*",
    "scriptc": "0.0.36",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT OR Apache-2.0"
}
