{
  "name": "@quickgui/cli",
  "version": "0.1.4-next.4",
  "description": "Project, development, and packaging CLI for natively compiled QuickGUI applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist/quickgui.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/egoist/quickgui/issues",
  "homepage": "https://github.com/egoist/quickgui#readme",
  "type": "module",
  "bin": {
    "quickgui": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "README.md",
    "src/args.ts",
    "src/build.ts",
    "src/cli.ts",
    "src/config.ts",
    "src/dev.ts",
    "src/error.ts",
    "src/extensions.ts",
    "src/extension-resources.ts",
    "src/index.ts",
    "src/init.ts",
    "src/init-extension.ts",
    "src/language-pack.ts",
    "src/native-build.ts",
    "src/go-build.ts",
    "src/rust-build.ts",
    "src/typescript-build.ts",
    "src/typescript-compiler.ts",
    "src/targets.ts",
    "templates",
    "src/packaging",
    "vendor",
    "!**/*.test.ts"
  ],
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@quickgui/native": "workspace:*",
    "@solidjs/compiler": "2.0.0-rc.8"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT OR Apache-2.0"
}
