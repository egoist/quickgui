{
  "name": "@quickgui/extension-updater",
  "version": "0.1.4-next.4",
  "description": "Optional Sparkle-compatible automatic updater for QuickGUI",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist/quickgui.git",
    "directory": "packages/extension-updater"
  },
  "files": [
    "src",
    "lib/*/*.dylib",
    "lib/*/*.so",
    "lib/*/*.dll",
    "lib/*/*.qgr",
    "lib/*/quickgui-updater-helper*",
    "README.md",
    "quickgui.extension.json"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./quickgui.extension.json": "./quickgui.extension.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@quickgui/native": "workspace:*"
  }
}
