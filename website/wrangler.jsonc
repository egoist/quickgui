/**
 * Default Wrangler config for `npx wrangler deploy` / `npx wrangler versions
 * upload`. Workers Builds preview deploys use the latter and do not run the
 * dashboard Build command unless it is set separately.
 *
 * Do not point `main` at workers/app.ts: that file imports Vite's
 * `virtual:react-router/server-build` and cannot be bundled by Wrangler.
 * Vite and `wrangler types` use wrangler.dev.jsonc instead.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quickgui",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./build/server/index.js",
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": ["**/*.js", "**/*.mjs"]
		}
	],
	"assets": {
		"directory": "./build/client"
	},
	"observability": {
		"enabled": true
	},
	"build": {
		"command": "bun ./scripts/ensure-worker-build.ts"
	}
}
