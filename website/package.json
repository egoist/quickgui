{
	"name": "website",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"test": "bun test --tsconfig-override ./tsconfig.cloudflare.json ./tests",
		"docs:index": "bun ./scripts/build-docs-search-index.ts",
		"docs:check": "bun ./scripts/build-component-api.ts --check && bun ./scripts/build-demo-sources.ts --check && bun run docs:index && bun test ./tests/docs.test.ts ./tests/component-api.test.ts",
		"docs:translate": "bun ./scripts/generate-doc-translations.ts",
		"dev": "bun run docs:api && bun run docs:wasm && bun run docs:index && react-router dev --port 3000",
		"build": "bun run docs:api && bun run docs:wasm && bun run docs:index && react-router build",
		"preview": "bun run build && vite preview",
		"deploy": "bun ./scripts/deploy.ts",
		"cf-typegen": "wrangler types",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"docs:api": "bun ./scripts/build-component-api.ts",
		"docs:wasm": "bun ./scripts/build-demos.ts"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"i18next": "^26.4.0",
		"isbot": "^5",
		"lucide-react": "^1.37.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-i18next": "^17.0.12",
		"react-router": "^8.3.1",
		"shiki": "^4.4.3",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"zbsearch": "4.0.0"
	},
	"devDependencies": {
		"@babel/parser": "^7.29.8",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@egoist/tailwindcss-icons": "^1.9.2",
		"@iconify-json/lucide": "^1.2.127",
		"@iconify-json/simple-icons": "^1.2.94",
		"@mdx-js/rollup": "^3.1.1",
		"@react-router/dev": "^8.3.1",
		"@shikijs/rehype": "^4.4.3",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"github-slugger": "^2.0.0",
		"mdast-util-to-string": "^4.0.0",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"typescript": "7.0.2",
		"unified": "^11.0.5",
		"vite": "^8.0.0",
		"wrangler": "^4.127.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}
