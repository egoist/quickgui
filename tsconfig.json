{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ESNext"
    ],
    "module": "Preserve",
    "jsx": "preserve",
    "jsxImportSource": "@quickgui/solid",
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "bun"
    ]
  },
  "include": [
    "packages/cli/src/**/*.ts",
    "packages/native/build.ts",
    "packages/native/src/**/*.ts",
    "packages/native/test/**/*.ts",
    "extensions/updater/js/**/*.ts",
    "extensions/terminal/js/**/*.ts",
    "extensions/updater/js/test/**/*.ts",
    "extensions/editor/js/**/*.ts",
    "extensions/editor/js/test/**/*.ts",
    "extensions/markdown/js/**/*.ts",
    "extensions/markdown/js/test/**/*.ts",
    "packages/solid/test/**/*.ts",
    "packages/solid/src/**/*.ts",
    "examples/components-typescript/**/*.ts",
    "examples/components-typescript/**/*.tsx",
    "examples/quick-git-typescript/**/*.ts",
    "examples/quick-git-typescript/**/*.tsx",
    "packages/solid/test/**/*.tsx",
    "examples/counter-typescript/*.tsx",
    "examples/code-morph-typescript/*.ts",
    "examples/code-morph-typescript/*.tsx",
    "benchmarks/desktop/quickgui-typescript/*.ts",
    "benchmarks/desktop/quickgui-typescript/*.tsx",
    "examples/*/quickgui.config.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "packages/cli/templates",
    "packages/cli/test-fixtures"
  ]
}
